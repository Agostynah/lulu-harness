# Copy to .env (already gitignored) and fill in.
#
# Only the key matching your model.provider (set in lulu.toml, default
# "anthropic") needs a real value. All 235 tests mock every provider's
# SDK -- none of this is needed to run the test suite.

# provider = "anthropic" (the default). Not read directly by this
# codebase -- the `anthropic` SDK picks this up automatically.
ANTHROPIC_API_KEY=

# provider = "openrouter". Read explicitly by llm/openrouter_client.py
# (the SDK's own auto-detected env var name doesn't match, since it's
# built for OpenAI's own API by default).
#
# Whatever model you set in lulu.toml MUST support tool/function calling
# -- Lulu's loop is built entirely around it, it's not optional. Check a
# model's page on openrouter.ai for "Tools" support before picking one.
OPENROUTER_API_KEY=

# provider = "ollama". No key needed -- Ollama runs locally with no auth.
# Make sure the model you set in lulu.toml is pulled locally and actually
# supports tool calling (not every model in Ollama's library does).
