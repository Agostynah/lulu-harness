# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
uv.lock.tmp

# Node (apps/inspector)
node_modules/
dist/
.vite/
*.tsbuildinfo

# PyInstaller sidecar build (packages/lulu-core/sidecar_entry.py is the
# source; `dist/lulu-server` and this spec are regenerated by the uv run
# pyinstaller command in ROADMAP.md/README -- not meant to be committed).
build/
lulu-server.spec

# Tauri sidecar binaries -- platform-specific PyInstaller output, huge,
# regenerated by the same pyinstaller command and copied in before
# `cargo tauri build` (see apps/inspector/src-tauri/tauri.conf.json's
# externalBin). Never meant to be committed, only locally built.
apps/inspector/src-tauri/binaries/

# Runtime data / logs (regenerable, and the dataset stays local by default)
.lulu/logs/
.lulu/data/
.lulu/locks/
**/data/*.db
**/data/*.db-wal
**/data/*.db-shm
**/data/*.idmap.json

# FastEmbed / ONNX model cache
.fastembed_cache/
models/

# eval corpus/embedding cache (regenerable, and can be large)
evals/**/.cache/

# Secrets
.env
*.key

# Personal planning notes -- never meant for the public repo, unlike
# docs/THESIS.md's Roadmap section which IS meant to be public.
decisions_todo.md
